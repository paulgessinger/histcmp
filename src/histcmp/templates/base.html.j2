<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{ comparison.title | e }}</title>
        <style>
        {{ static_content("css/bulma/bulma.min.css") }}
        {{ static_content("css/main.css") }}
        </style>
    </head>
    <body>
        <main class="report">
            <header class="report-header">
                <h1 class="title">{{ comparison.title | e }}</h1>
                <details class="input-files">
                    <summary>{{ (comparison.label_monitored or "Monitored") | e }} vs.
                        {{ (comparison.label_reference or "Reference") | e }} — input files</summary>
                    <p>{{ comparison.file_a | e }}</p>
                    <p>{{ comparison.file_b | e }}</p>
                </details>
            </header>
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
